<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exportScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <!-- Center Bento Modal Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardExportModal"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/surfaceContainerHigh"
        app:strokeColor="@color/outlineVariant"
        app:strokeWidth="1dp"
        app:cardElevation="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Title Text -->
            <TextView
                android:id="@+id/tvExportTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_saving_video"
                android:textColor="@color/textColor"
                android:fontFamily="sans-serif-bold"
                android:textSize="20sp" />

            <!-- Subtitle Text -->
            <TextView
                android:id="@+id/tvExportMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/str_please_don_t_close_the_app"
                android:textAlignment="center"
                android:textColor="@color/outline"
                android:fontFamily="sans-serif"
                android:textSize="13sp" />

            <!-- Video Thumbnail with Progress Ring around it -->
            <FrameLayout
                android:id="@+id/layoutExportVideoPreview"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <!-- Circular Progress Ring around the video image -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/exportProgressIndicator"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    app:indicatorSize="150dp"
                    app:trackThickness="6dp"
                    app:trackCornerRadius="3dp"
                    app:trackColor="#26FFFFFF"
                    app:indicatorColor="@color/colorPrimary"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0" />

                <!-- Circular Video Preview Image -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivExportVideoThumbnail"
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_hero_bento_primary"
                    app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

                <!-- Subtle circular scrim over image for text/icon readability -->
                <View
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_scrim_overlay" />

                <!-- Progress Percentage Badge (Visible while saving) -->
                <FrameLayout
                    android:id="@+id/layoutExportPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_progress_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvExportPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/str_0"
                        android:textColor="@android:color/white"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="17sp" />
                </FrameLayout>

                <!-- Play Button Overlay on Thumbnail (Visible on completion) -->
                <FrameLayout
                    android:id="@+id/layoutExportPlayBadge"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_play_button"
                    android:elevation="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_play_24"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <!-- Completion Checkmark Badge (Visible on completion) -->
                <FrameLayout
                    android:id="@+id/layoutExportSuccessBadge"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/circle_success_badge"
                    android:elevation="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_24"
                        app:tint="@android:color/white" />
                </FrameLayout>

            </FrameLayout>

            <!-- Completion Hint Text -->
            <TextView
                android:id="@+id/tvExportCompletionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/str_tap_to_play_video"
                android:textColor="@color/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Cancel Button (Visible during saving) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelExport"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/cancel"
                android:textColor="@color/textColor"
                android:backgroundTint="@color/surfaceVariant"
                app:strokeWidth="0dp"
                app:cornerRadius="22dp"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Completed Actions (Visible on completion) -->
            <LinearLayout
                android:id="@+id/layoutExportCompletedActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayExportedVideo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/str_play_video"
                    android:textColor="@color/onPrimaryContainer"
                    android:backgroundTint="@color/colorPrimary"
                    app:icon="@drawable/ic_play_24"
                    app:iconTint="@color/onPrimaryContainer"
                    app:iconGravity="textStart"
                    app:cornerRadius="24dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareExportedVideo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/surfaceVariant"
                    app:icon="@drawable/ic_share_24"
                    app:iconTint="@color/textColor"
                    app:iconGravity="textStart"
                    app:cornerRadius="24dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDoneExport"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="72dp"
                    android:text="Done"
                    android:textColor="@color/textColor"
                    android:backgroundTint="@color/surfaceVariant"
                    app:strokeWidth="0dp"
                    app:cornerRadius="24dp"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
